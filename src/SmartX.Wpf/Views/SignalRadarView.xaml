<UserControl x:Class="SmartX.Wpf.Views.SignalRadarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:SmartX.Wpf.Controls"
             xmlns:vm="clr-namespace:SmartX.Desktop.Client.ViewModels;assembly=SmartX.Desktop.Client">

    <UserControl.Resources>

        <DataTemplate x:Key="AlertRow" DataType="{x:Type vm:AlertViewModel}">
            <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="7"
                    Background="{StaticResource BgSunken}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontSize="12"
                                   FontWeight="SemiBold"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding StateLabel}"
                                   FontFamily="{StaticResource Mono}" FontSize="8.5" FontWeight="Bold"
                                   Foreground="{Binding State, Converter={StaticResource StateBrush}}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" MaxHeight="32"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <StackPanel>

        <TextBlock Text="D Y N A M I C   E N G A G E M E N T   ·   S I G N A T U R E   F E A T U R E"
                   Style="{StaticResource Eyebrow}"/>
        <TextBlock Text="Signal Radar, live anomaly sweep" Style="{StaticResource PageTitle}"/>
        <TextBlock Style="{StaticResource PageLead}"
                   Text="Not a progress bar. A radar sweep positions every node by deployment zone, then scores each reading against that node's own rolling baseline instead of one global threshold. A spike flares, a wedged sensor turns violet, and a node that stops publishing fades to grey where it stood."/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="10">
                <Grid>
                    <!-- drawn in code rather than built out of shapes, every node beats at its own rate and markup cannot vary that -->
                    <ctrl:SignalRadarControl Height="470"
                                             ItemsSource="{Binding RadarPoints}"
                                             SelectedMacAddress="{Binding SelectedMacAddress, Mode=TwoWay}"/>

                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="14,0,0,10"
                                Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Teal}" Margin="0,0,6,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Healthy, StringFormat={}healthy {0}}"
                                       Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Amber}" Margin="0,0,6,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Drifting, StringFormat={}drifting {0}}"
                                       Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Rose}" Margin="0,0,6,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Flaring, StringFormat={}flaring {0}}"
                                       Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Violet}" Margin="0,0,6,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Stalled, StringFormat={}stalled {0}}"
                                       Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Slate}" Margin="0,0,6,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Flatlined, StringFormat={}flatlined {0}}"
                                       Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1">

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="M E S H   I N T E G R I T Y" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="{Binding MeshIntegrityDisplay}" Style="{StaticResource StatValue}"
                                   FontSize="26" Foreground="{StaticResource Teal}"/>
                        <TextBlock Text="{Binding TotalNodes, StringFormat={}{0} nodes on the sweep}"
                                   Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="A T T E N T I O N   Q U E U E" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Worst first, ranked by the gateway"
                                   Style="{StaticResource Caption}" Margin="0,0,0,14"/>

                        <ItemsControl ItemsSource="{Binding Alerts}" ItemTemplate="{StaticResource AlertRow}"/>

                        <TextBlock Text="every node is on cadence" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center" Margin="0,20"
                                   Foreground="{StaticResource Teal}"
                                   Visibility="{Binding Alerts.Count, Converter={StaticResource CountToVis},
                                                        ConverterParameter=Invert}"/>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,8,0,14"/>

                        <TextBlock Text="P R O V E   T H E   D E T E C T O R" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="{Binding SelectedSensorDisplay}" Style="{StaticResource MonoDim}"
                                   FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                        <WrapPanel>
                            <Button Content="Spike" Command="{Binding InjectFaultCommand}"
                                    CommandParameter="spike" Margin="0,0,7,7" Padding="12,6"/>
                            <Button Content="Disconnect" Command="{Binding InjectFaultCommand}"
                                    CommandParameter="disconnect" Margin="0,0,7,7" Padding="12,6"/>
                            <Button Content="Wedge" Command="{Binding InjectFaultCommand}"
                                    CommandParameter="stall" Margin="0,0,7,7" Padding="12,6"/>
                            <Button Content="Clear" Command="{Binding InjectFaultCommand}"
                                    CommandParameter="clear" Margin="0,0,0,7" Padding="12,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
