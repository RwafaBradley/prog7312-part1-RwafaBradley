<UserControl x:Class="SmartX.Wpf.Views.RegisterSensorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:SmartX.Core.Domain;assembly=SmartX.Core">

    <UserControl.Resources>

        <Style x:Key="CategoryCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Width="176" Height="112" CornerRadius="9"
                                Background="{StaticResource BgSunken}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LineBright}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Amber}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#17130A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <StackPanel MaxWidth="900" HorizontalAlignment="Left">

        <TextBlock Text="S E N S O R   P A Y L O A D   M A N A G E M E N T" Style="{StaticResource Eyebrow}"/>
        <TextBlock Text="Register a sensor node" Style="{StaticResource PageTitle}"/>
        <TextBlock Style="{StaticResource PageLead}"
                   Text="Attach a custom registration record. Fields are checked here as you type and checked again by the .NET API on submit, because physical nodes post straight to the gateway and never pass through this form."/>

        <Border Style="{StaticResource Card}">
            <StackPanel>

                <TextBlock Text="Device MAC address  /  unique identifier" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Form.MacAddress, UpdateSourceTrigger=PropertyChanged,
                                        ValidatesOnNotifyDataErrors=True}"
                         FontSize="15" Padding="13,11"/>

                <StackPanel Orientation="Horizontal" Margin="0,7,0,20">
                    <TextBlock Text="&#x2713;" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource InkFaint}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Form.IsMacValid}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Teal}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Form.MacHint}" FontFamily="{StaticResource Mono}" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource InkFaint}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Form.IsMacValid}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Teal}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Facility" Style="{StaticResource FieldLabel}"/>
                        <TextBox FontFamily="{StaticResource Sans}"
                                 Text="{Binding Form.Facility, UpdateSourceTrigger=PropertyChanged,
                                                ValidatesOnNotifyDataErrors=True}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Alias" Style="{StaticResource FieldLabel}"/>
                        <TextBox FontFamily="{StaticResource Sans}"
                                 Text="{Binding Form.Alias, UpdateSourceTrigger=PropertyChanged,
                                                ValidatesOnNotifyDataErrors=True}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Zone" Style="{StaticResource FieldLabel}"/>
                        <TextBox FontFamily="{StaticResource Sans}"
                                 Text="{Binding Form.Zone, UpdateSourceTrigger=PropertyChanged,
                                                ValidatesOnNotifyDataErrors=True}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Sub zone" Style="{StaticResource FieldLabel}"/>
                        <TextBox FontFamily="{StaticResource Sans}"
                                 Text="{Binding Form.SubZone, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Node ID" Style="{StaticResource FieldLabel}"/>
                        <TextBox FontFamily="{StaticResource Sans}"
                                 Text="{Binding Form.NodeId, UpdateSourceTrigger=PropertyChanged,
                                                ValidatesOnNotifyDataErrors=True}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Sensor category" Style="{StaticResource FieldLabel}"/>

                <!-- picking one of these three decides the value type, and the gateway opens the matching pipe on submit -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">

                    <RadioButton Style="{StaticResource CategoryCard}" GroupName="Category"
                                 IsChecked="{Binding Form.Category, Mode=TwoWay,
                                                     Converter={StaticResource EnumMatch},
                                                     ConverterParameter={x:Static domain:SensorCategory.Environmental}}">
                        <StackPanel>
                            <Path Data="M7,0 A3,3 0 0 1 13,0 V16 A3,3 0 0 1 7,16 Z M10,3 V14"
                                  Stroke="{StaticResource Rose}" StrokeThickness="1.4"
                                  Width="22" Height="22" Stretch="Uniform"
                                  HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Environmental" FontSize="12.5" HorizontalAlignment="Center"/>
                            <TextBlock Text="float" FontFamily="{StaticResource Mono}" FontSize="10"
                                       Foreground="{StaticResource InkFaint}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource CategoryCard}" GroupName="Category"
                                 IsChecked="{Binding Form.Category, Mode=TwoWay,
                                                     Converter={StaticResource EnumMatch},
                                                     ConverterParameter={x:Static domain:SensorCategory.PowerConsumption}}">
                        <StackPanel>
                            <Path Data="M11,0 L3,11 H9 L7,20 L16,8 H10 Z"
                                  Fill="{StaticResource Amber}"
                                  Width="20" Height="22" Stretch="Uniform"
                                  HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Power" FontSize="12.5" HorizontalAlignment="Center"/>
                            <TextBlock Text="int" FontFamily="{StaticResource Mono}" FontSize="10"
                                       Foreground="{StaticResource InkFaint}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource CategoryCard}" GroupName="Category"
                                 IsChecked="{Binding Form.Category, Mode=TwoWay,
                                                     Converter={StaticResource EnumMatch},
                                                     ConverterParameter={x:Static domain:SensorCategory.Actuator}}">
                        <StackPanel>
                            <Path Data="M0,4 H20 V16 H0 Z M13,4 V16"
                                  Stroke="{StaticResource Violet}" StrokeThickness="1.4"
                                  Width="22" Height="22" Stretch="Uniform"
                                  HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Actuator" FontSize="12.5" HorizontalAlignment="Center"/>
                            <TextBlock Text="bool" FontFamily="{StaticResource Mono}" FontSize="10"
                                       Foreground="{StaticResource InkFaint}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton>

                </StackPanel>

                <TextBlock Text="{Binding Form.CategoryHint}" Style="{StaticResource Caption}"
                           Margin="0,4,0,20"/>

                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Unit" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Form.Unit, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Expected min" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Form.MinExpected, UpdateSourceTrigger=PropertyChanged,
                                                ValidatesOnNotifyDataErrors=True}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Expected max" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Form.MaxExpected, UpdateSourceTrigger=PropertyChanged,
                                                ValidatesOnNotifyDataErrors=True}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Firmware" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Form.FirmwareVersion, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,18"/>

                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}"
                               VerticalAlignment="Center"
                               Text="the category fixes which typed channel the gateway opens for this node"/>

                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Content="Register &amp; POST to API" Margin="10,0,0,0" Padding="18,9"
                            Command="{Binding RegisterCommand}"/>

                    <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}"
                            Content="Cancel" Padding="14,9"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Overview"/>
                </DockPanel>

            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
