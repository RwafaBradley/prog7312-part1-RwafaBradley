<UserControl x:Class="SmartX.Wpf.Views.FileAttachmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:SmartX.Desktop.Client.Services;assembly=SmartX.Desktop.Client">

    <UserControl.Resources>

        <DataTemplate x:Key="AttachmentRow" DataType="{x:Type svc:AttachmentView}">
            <Border Padding="14,12" Margin="0,0,0,9" CornerRadius="8"
                    Background="{StaticResource BgSunken}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Data="M2,0 H9 L13,4 V15 H2 Z M9,0 V4 H13"
                          Stroke="{StaticResource Teal}" StrokeThickness="1.3"
                          Width="16" Height="17" Stretch="Uniform"
                          VerticalAlignment="Center" HorizontalAlignment="Left"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" FontSize="12.5"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource Caption}"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Kind}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <Border Height="3" CornerRadius="2" Background="{StaticResource Teal}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="14,0,0,0">
                        <TextBlock Text="100%" Style="{StaticResource MonoDim}" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                   Foreground="{StaticResource Teal}"/>
                        <Button Style="{StaticResource QuietButton}" Content="Save as"
                                Command="{Binding DataContext.DownloadAttachmentCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource QuietButton}" Content="Remove"
                                Foreground="{StaticResource Rose}"
                                Command="{Binding DataContext.RemoveAttachmentCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <StackPanel MaxWidth="960" HorizontalAlignment="Left">

        <TextBlock Text="M E D I A   /   L O G   A T T A C H M E N T" Style="{StaticResource Eyebrow}"/>
        <TextBlock Text="Attach files to a sensor profile" Style="{StaticResource PageTitle}"/>
        <TextBlock Style="{StaticResource PageLead}"
                   Text="Config files, deployment photos or hardware logs, streamed to the API as multipart and written to disk in small chunks so a large photograph never has to sit in memory in one piece."/>

        <Border Style="{StaticResource Card}">
            <StackPanel>

                <TextBlock Text="Target sensor profile" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Sensors}" SelectedItem="{Binding SelectedSensor, Mode=TwoWay}"
                          Margin="0,0,0,18" Padding="12,9">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding MacAddress}" FontFamily="{StaticResource Mono}"
                                           FontSize="12" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding CategoryName}" FontSize="11.5"
                                           Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Zone}" FontSize="11.5"
                                           Foreground="{StaticResource InkDim}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- dragging a file in and browsing for one both end in the same upload call -->
                <Button x:Name="DropZone" AllowDrop="True"
                        DragOver="OnDropZoneDragOver" Drop="OnDropZoneDrop" Click="OnDropZoneClick"
                        Background="Transparent" BorderBrush="Transparent" Padding="0" Margin="0,0,0,20">
                    <Border Height="188" CornerRadius="10" Background="#0C0F15"
                            BorderBrush="{StaticResource LineBright}" BorderThickness="1.4">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Data="M9,16 V2 M3,7 L9,1 L15,7"
                                  Stroke="{StaticResource InkDim}" StrokeThickness="1.4"
                                  Width="24" Height="24" Stretch="Uniform"
                                  HorizontalAlignment="Center" Margin="0,0,0,14"/>
                            <TextBlock Text="Drop files or click to browse" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="OpenFileDialog  ·  multipart/form-data  ·  max 25 MB per file"
                                       Style="{StaticResource Caption}" HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="json  yaml  toml  ini  xml  csv  ·  log  txt  ndjson  ·  jpg  png  webp  ·  zip  pcap"
                                       Style="{StaticResource Caption}" HorizontalAlignment="Center"
                                       Foreground="{StaticResource InkFaint}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Button>

                <ItemsControl ItemsSource="{Binding SelectedSensor.Attachments}"
                              ItemTemplate="{StaticResource AttachmentRow}"/>

                <TextBlock Text="nothing attached to this profile yet" Style="{StaticResource Caption}"
                           HorizontalAlignment="Center" Margin="0,10,0,0"
                           Visibility="{Binding SelectedSensor.Attachments.Count,
                                                Converter={StaticResource CountToVis},
                                                ConverterParameter=Invert}"/>

            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
