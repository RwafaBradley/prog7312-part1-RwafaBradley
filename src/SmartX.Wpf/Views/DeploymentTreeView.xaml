<UserControl x:Class="SmartX.Wpf.Views.DeploymentTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartX.Desktop.Client.ViewModels;assembly=SmartX.Desktop.Client"
             xmlns:topo="clr-namespace:SmartX.Core.Topology;assembly=SmartX.Core">

    <UserControl.Resources>

        <DataTemplate x:Key="TreeRow" DataType="{x:Type vm:DeploymentRowViewModel}">
            <Grid Margin="{Binding Indent, Converter={StaticResource Indent}}" Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Glyph}" Style="{StaticResource MonoDim}"
                           VerticalAlignment="Center" Margin="0,0,9,0"/>

                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Mono}"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Depth}" Value="0">
                                    <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="2" Text="{Binding DepthLabel}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>

                <TextBlock Grid.Column="3" Text="{Binding MacAddress}" Style="{StaticResource MonoDim}"
                           FontSize="10.5" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Column="4" Text="&#x2713;" VerticalAlignment="Center"
                           TextAlignment="Center" FontSize="12"
                           Foreground="{StaticResource Teal}"
                           Visibility="{Binding Checked, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TraceRow" DataType="{x:Type vm:TraceStepViewModel}">
            <StackPanel Orientation="Horizontal" Margin="{Binding Indent, Converter={StaticResource Indent}}"
                        Height="24">
                <TextBlock Text="&#x2022;" Style="{StaticResource MonoDim}" Margin="0,0,8,0"
                           VerticalAlignment="Center" Foreground="{StaticResource Teal}"/>
                <TextBlock Text="{Binding Call}" Style="{StaticResource Mono}" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FindingRow" DataType="{x:Type topo:ValidationFinding}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="{Binding Code}" Style="{StaticResource Mono}" FontSize="10.5" Width="170"
                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                           MaxWidth="420"/>
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <StackPanel>

        <TextBlock Text="D A T A   H A N D L I N G" Style="{StaticResource Eyebrow}"/>
        <TextBlock Text="Recursive deployment validation" Style="{StaticResource PageTitle}"/>
        <TextBlock Style="{StaticResource PageLead}"
                   Text="Before a node is accepted, a recursive walk confirms it sits inside a valid parent chain, from leaf up to facility root. The walk carries a depth ceiling and a cycle guard, because a stack overflow cannot be caught and would take the gateway down with it."/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Deployment tree" Style="{StaticResource Caption}" Margin="0,0,0,14"/>

                    <!-- these rows come from the same walk the validator does, so the ticks appearing are the recursion finishing -->
                    <ItemsControl ItemsSource="{Binding TreeRows}" ItemTemplate="{StaticResource TreeRow}"/>

                    <TextBlock Text="waiting for the gateway" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,26"
                               Visibility="{Binding TreeRows.Count, Converter={StaticResource CountToVis},
                                                    ConverterParameter=Invert}"/>

                    <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,16"/>

                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Style="{StaticResource TealButton}"
                                Content="&#x25B6;   Run validator"
                                Command="{Binding ValidateTopologyCommand}"/>
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Style="{StaticResource Caption}" Text="{Binding TopologySummary}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1">

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="V a l i d a t e ( )   ·   r e c u r s i v e   t r a c e"
                                   Style="{StaticResource Eyebrow}"/>

                        <ItemsControl ItemsSource="{Binding ValidatorTrace}"
                                      ItemTemplate="{StaticResource TraceRow}" Margin="0,6,0,14"/>

                        <Border Style="{StaticResource InnerCard}">
                            <TextBlock Style="{StaticResource Code}" FontSize="11" xml:space="preserve">bool Validate(Node n) =&gt;
    n.Parent == null
        ? n.IsRoot
        : n.IsValidChild &amp;&amp; Validate(n.Parent);</TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="F I N D I N G S" Style="{StaticResource Eyebrow}"/>

                        <TextBlock Text="no errors raised at any depth" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Teal}" Margin="0,4,0,0"
                                   Visibility="{Binding TopologyFindings.Count,
                                                        Converter={StaticResource CountToVis},
                                                        ConverterParameter=Invert}"/>

                        <ItemsControl ItemsSource="{Binding TopologyFindings}"
                                      ItemTemplate="{StaticResource FindingRow}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
