<Window x:Class="SmartX.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SmartX.Desktop.Client.ViewModels;assembly=SmartX.Desktop.Client"
        xmlns:views="clr-namespace:SmartX.Wpf.Views"
        Title="Smart X Gateway Console"
        Height="920" Width="1500"
        MinHeight="640" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>

        <Style x:Key="NavItem" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource InkDim}"/>
        </Style>

    </Window.Resources>

    <Grid>

        <views:GatewayView Visibility="{Binding IsGateway, Converter={StaticResource BoolToVis}}"/>

        <Grid Visibility="{Binding IsInsideIngestion, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- the sidebar stays put and only the right hand panel swaps, so the map never moves under you -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebar}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">

                    <StackPanel DockPanel.Dock="Top" Margin="0,18,0,0">
                        <Button Style="{StaticResource QuietButton}" Margin="20,0,0,14"
                                HorizontalAlignment="Left"
                                Command="{Binding BackToGatewayCommand}">
                            <TextBlock Text="&#x2039;   B A C K   T O   G A T E W A Y"
                                       FontSize="9.5" Foreground="{StaticResource InkFaint}"/>
                        </Button>

                        <StackPanel Orientation="Horizontal" Margin="20,0,0,4">
                            <Path Data="M 5,0 L 10,5 L 5,10 L 0,5 Z" Fill="{StaticResource Amber}"
                                  Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center"
                                  Margin="0,0,9,0"/>
                            <TextBlock Text="Telemetry Ingestion" FontSize="15.5" FontWeight="Bold"
                                       Foreground="{StaticResource Ink}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                        <Border Height="1" Background="{StaticResource Line}" Margin="20,10,20,12"/>

                        <StackPanel Orientation="Horizontal" Margin="22,0,0,10">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,9,0"
                                     Fill="{Binding IsConnected, Converter={StaticResource StatusBrush},
                                                    ConverterParameter=Invert}"/>
                            <TextBlock Text="{Binding ApiEndpointDisplay}" Style="{StaticResource MonoDim}"
                                       FontSize="10.5"/>
                        </StackPanel>

                        <Button Style="{StaticResource QuietButton}" Margin="18,0,0,0"
                                HorizontalAlignment="Left" Command="{Binding BackToGatewayCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x21A9;" FontSize="12" Margin="0,0,9,0"
                                           Foreground="{StaticResource InkFaint}"/>
                                <TextBlock Text="Leave console" FontSize="12"
                                           Foreground="{StaticResource InkFaint}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="M O N I T O R" Style="{StaticResource SectionLabel}"/>

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:Section.Overview}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M0,0 H6 V6 H0 Z M9,0 H15 V6 H9 Z M0,9 H6 V15 H0 Z M9,9 H15 V15 H9 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,13,0"/>
                                <TextBlock Text="Overview" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverview}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                                            <Setter Property="Background" Value="#171510"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:Section.SignalRadar}">
                            <DockPanel LastChildFill="False">
                                <Path Data="M7.5,0 A7.5,7.5 0 1 1 7.49,0 Z M7.5,7.5 L7.5,3 M7.5,7.5 L11,9"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,13,0" DockPanel.Dock="Left"/>
                                <TextBlock Text="Signal Radar" VerticalAlignment="Center" DockPanel.Dock="Left"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Border DockPanel.Dock="Right" CornerRadius="3" Padding="6,1"
                                        Background="{StaticResource TealSoft}" VerticalAlignment="Center">
                                    <TextBlock Text="LIVE" FontFamily="{StaticResource Mono}" FontSize="8.5"
                                               FontWeight="Bold" Foreground="{StaticResource Teal}"/>
                                </Border>
                            </DockPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSignalRadar}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                                            <Setter Property="Background" Value="#171510"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock Text="I N G E S T" Style="{StaticResource SectionLabel}"/>

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:Section.RegisterSensor}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M7.5,0 V15 M0,7.5 H15"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" Width="15" Height="15" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,13,0"/>
                                <TextBlock Text="Register Sensor" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRegisterSensor}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                                            <Setter Property="Background" Value="#171510"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:Section.TelemetryStream}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M0,11 L3,11 L5,3 L8,15 L10,7 L12,11 L15,11"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,13,0"/>
                                <TextBlock Text="Telemetry Stream" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTelemetryStream}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                                            <Setter Property="Background" Value="#171510"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:Section.DeploymentTree}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M7.5,1 V5 M2,14 V10 M13,14 V10 M2,10 H13 M7.5,5 V10"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,13,0"/>
                                <TextBlock Text="Deployment Tree" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeploymentTree}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                                            <Setter Property="Background" Value="#171510"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:Section.FileAttachments}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M2,0 H9 L13,4 V15 H2 Z M9,0 V4 H13"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,13,0"/>
                                <TextBlock Text="File Attachments" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFileAttachments}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                                            <Setter Property="Background" Value="#171510"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="32,20,28,16" BorderBrush="{StaticResource Line}"
                        BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{Binding SectionTitle}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SectionSubtitle}" Style="{StaticResource Caption}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button DockPanel.Dock="Right" Style="{StaticResource TealButton}" Margin="10,0,0,0"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:Section.RegisterSensor}"
                                Content="+  New sensor"/>

                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0"
                                         Fill="{Binding StatusIsError, Converter={StaticResource StatusBrush}}"/>
                                <TextBlock Text="{Binding LastApiDisplay}" Style="{StaticResource MonoDim}"
                                           FontSize="10.5"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,24,28,24">
                    <Grid>
                        <views:OverviewView Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}"/>
                        <views:SignalRadarView Visibility="{Binding IsSignalRadar, Converter={StaticResource BoolToVis}}"/>
                        <views:RegisterSensorView Visibility="{Binding IsRegisterSensor, Converter={StaticResource BoolToVis}}"/>
                        <views:TelemetryStreamView Visibility="{Binding IsTelemetryStream, Converter={StaticResource BoolToVis}}"/>
                        <views:DeploymentTreeView Visibility="{Binding IsDeploymentTree, Converter={StaticResource BoolToVis}}"/>
                        <views:FileAttachmentsView Visibility="{Binding IsFileAttachments, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="32,10" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ConnectionMessage}"
                                   Style="{StaticResource MonoDim}" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="0,0,22,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Runtime}"
                                   Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" FontSize="11.5"
                                   Foreground="{Binding StatusIsError, Converter={StaticResource StatusBrush}}"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
