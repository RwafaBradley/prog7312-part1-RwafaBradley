{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SmartX": {
    "WindowSize": 512,
    "TickIntervalMs": 1000,
    "AttachmentRoot": "App_Data/attachments",
    "Seed": {
      "Environmental": 9,
      "Power": 5,
      "Actuators": 4
    }
  }
}
